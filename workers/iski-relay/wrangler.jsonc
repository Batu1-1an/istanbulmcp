{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "istanbul-iski-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "cfa9eb84e43e41f7b1e293a76267d8b3"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
