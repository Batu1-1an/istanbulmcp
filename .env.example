APP_NAME=istanbul-mcp
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=.data/istanbul_mcp.sqlite3
MAX_RADIUS_M=5000
DEFAULT_LIMIT=20
MAX_LIMIT=100
REQUEST_TIMEOUT_SECONDS=15
CKAN_RATE_CAPACITY=6
CKAN_RATE_REFILL_PER_SECOND=2
CKAN_RATE_MAX_WAIT_SECONDS=0.5
IETT_RATE_CAPACITY=2
IETT_RATE_REFILL_PER_SECOND=0.5
IETT_RATE_MAX_WAIT_SECONDS=0.2
AIR_QUALITY_RATE_CAPACITY=4
AIR_QUALITY_RATE_REFILL_PER_SECOND=1
AIR_QUALITY_RATE_MAX_WAIT_SECONDS=0.5
ISPARK_CACHE_TTL_SECONDS=300
METRO_CACHE_TTL_SECONDS=86400
AIR_QUALITY_STATION_CACHE_TTL_SECONDS=3600
AIR_QUALITY_READING_CACHE_TTL_SECONDS=900
TRAFFIC_CACHE_TTL_SECONDS=60
# Yalnız statik GTFS durak konumları; canlı varış veya stop_times ingestion değil.
GTFS_STOPS_MAX_BYTES=5242880
GTFS_STOPS_MAX_ROWS=50000
GTFS_STOPS_LOAD_TIMEOUT_SECONDS=20
GTFS_STOPS_CACHE_TTL_SECONDS=86400
GTFS_STOPS_STALE_IF_ERROR_SECONDS=604800
IBB_PHARMACY_BASE_URL=https://cbsproxy.ibb.gov.tr/?eczanews
IBB_PHARMACY_REQUEST_TIMEOUT_SECONDS=15
IBB_PHARMACY_REQUEST_ATTEMPTS=2
IBB_PHARMACY_CACHE_TTL_SECONDS=300
IBB_PHARMACY_STALE_IF_ERROR_SECONDS=1800
IBB_PHARMACY_MAX_CACHE_AGE_SECONDS=1800
IBB_PHARMACY_RATE_CAPACITY=2
IBB_PHARMACY_RATE_REFILL_PER_SECOND=0.5
IBB_PHARMACY_RATE_MAX_WAIT_SECONDS=0.5
SOCIAL_FACILITIES_BASE_URL=https://tesislerimiz.ibb.istanbul
SOCIAL_FACILITIES_CATALOG_URL=https://tesislerimiz.ibb.istanbul/tesisler
SOCIAL_FACILITIES_RESERVATION_URL=https://tesislerrezervasyon.ibb.istanbul/
SOCIAL_FACILITIES_CKAN_DOWNLOAD_URL=https://data.ibb.gov.tr/dataset/6e9b0cf3-d756-4301-8c5e-a6e3a223ed6d/resource/87517b4e-28b5-478f-a0ba-27291cf17b69/download/ibb-sosyal-tesis-konumlar.xlsx
SOCIAL_FACILITIES_REQUEST_TIMEOUT_SECONDS=15
SOCIAL_FACILITIES_REQUEST_ATTEMPTS=2
SOCIAL_FACILITIES_CACHE_TTL_SECONDS=86400
SOCIAL_FACILITIES_STALE_IF_ERROR_SECONDS=604800
SOCIAL_FACILITIES_RATE_CAPACITY=4
SOCIAL_FACILITIES_RATE_REFILL_PER_SECOND=0.5
SOCIAL_FACILITIES_RATE_MAX_WAIT_SECONDS=0.5
SOCIAL_FACILITIES_MAX_CATALOG_PAGES=10
SOCIAL_FACILITIES_MAX_DETAIL_PAGES=100
ISKI_REQUEST_TIMEOUT_SECONDS=5
ISKI_REQUEST_ATTEMPTS=1
ISKI_API_BASE_URL=https://iskiapi.iski.istanbul/api
ISKI_API_BEARER_TOKEN=
ISKI_RELAY_BASE_URL=
ISKI_RELAY_TOKEN=
ISKI_RELAY_TIMEOUT_SECONDS=15
ISKI_FAULTS_SNAPSHOT_JSON=
ISKI_FAULTS_SNAPSHOT_JSON_PART_1=
ISKI_FAULTS_SNAPSHOT_JSON_PART_2=
ISKI_DAMS_SNAPSHOT_JSON=
ISKI_FAULTS_SNAPSHOT_CAPTURED_AT=
ISKI_DAMS_SNAPSHOT_CAPTURED_AT=
ISKI_FAULTS_SNAPSHOT_MAX_AGE_SECONDS=21600
ISKI_DAMS_SNAPSHOT_MAX_AGE_SECONDS=86400
ISKI_RATE_CAPACITY=4
ISKI_RATE_REFILL_PER_SECOND=1
ISKI_RATE_MAX_WAIT_SECONDS=0.5
ISKI_FAULTS_CACHE_TTL_SECONDS=30
ISKI_DAMS_CACHE_TTL_SECONDS=60
ISKI_FAULTS_STALE_IF_ERROR_SECONDS=900
ISKI_DAMS_STALE_IF_ERROR_SECONDS=86400
SOURCE_CACHE_MAX_ENTRIES=1024
# Şehir Hatları tarife tool'u sehirhatlari.istanbul'daki Cloudflare 403 nedeniyle
# varsayılan olarak kapalıdır. Deploy'dan tarife erişimini doğrulamadan açmayın.
# SEHIR_HATLARI_RELAY_URL yalnızca iptal duyurularını taşır, tarifeyi değil.
FERRY_SCHEDULES_ENABLED=false
# Eski tool adlarını geçici olarak yeniden yayımlar (varsayılan kompakt yüzey).
MCP_LEGACY_TOOLS_ENABLED=false
FERRY_SCHEDULE_CACHE_TTL_SECONDS=120
FERRY_SCHEDULE_DEFAULT_LIMIT=50
METRO_ACCESSIBILITY_CACHE_TTL_SECONDS=120
METRO_ACCESSIBILITY_STALE_IF_ERROR_SECONDS=900
FERRY_SCHEDULE_MAX_LIMIT=100
MARMARAY_API_BASIC_TOKEN=
SEHIR_HATLARI_RELAY_URL=
SEHIR_HATLARI_RELAY_TOKEN=
# Guarded SQL kapalı allowlist ile gelir; yalnız kontrol edilen DataStore ID'lerini ekleyin.
CKAN_SQL_ALLOWED_RESOURCE_IDS=
CKAN_SQL_MAX_ROWS=50000
CKAN_SQL_MAX_BYTES=20971520
CKAN_SQL_PAGE_SIZE=5000
CKAN_SQL_SNAPSHOT_TTL_SECONDS=900
CKAN_SQL_LOAD_TIMEOUT_SECONDS=30
CKAN_SQL_QUERY_TIMEOUT_SECONDS=0.5
# Varsayılan public mod: MCP ucu anahtarsız çalışır, IP bazlı burst sınırı geçerlidir.
# Anahtar istemek için MCP_API_KEYS doldurun (tek başına auth'u açar) veya
# MCP_AUTH_REQUIRED=true yapın; o durumda anahtarsız sunucu başlamaz.
MCP_AUTH_REQUIRED=false
MCP_API_KEYS=
MCP_API_KEY_DAILY_QUOTA=10000
# Public modda istemci IP'si X-Forwarded-For'dan okunur. Container yalnız
# platform proxy'si üzerinden erişilebiliyorsa '*' doğrudur; doğrudan port
# açıksa daraltın (varsayılan 127.0.0.1).
FORWARDED_ALLOW_IPS=*
MCP_MAX_BODY_BYTES=262144
MCP_RATE_LIMIT_CAPACITY=60
MCP_RATE_LIMIT_REFILL_PER_SECOND=1
MCP_RATE_LIMIT_MAX_CLIENTS=2048
MCP_MAX_CONCURRENT_REQUESTS=25
